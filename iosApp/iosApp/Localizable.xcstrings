    "Couldn’t prepare this challenge. Try again.": {
      "extractionState": "manual",
      "comment": "Native Milestone 5 challenge presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t prepare this challenge. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar este reto. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgaben konnten nicht vorbereitet werden. Versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить задачи. Попробуйте ещё раз."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar este desafio. Tente novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चुनौती तैयार नहीं हो सकी। फिर कोशिश करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਚੁਣੌਤੀ ਤਿਆਰ ਨਹੀਂ ਹੋ ਸਕੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই চ্যালেঞ্জ প্রস্তুত করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备此挑战。请重试。"
          }
        }
      }
    },
    "Delivery could not be decoded. It remains queued for retry.": {
      "extractionState": "manual",
      "comment": "Native Milestone 5 delivery presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery could not be decoded. It remains queued for retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la entrega. Permanece en la cola para reintentar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgelöste Alarm konnte nicht gelesen werden. Er bleibt für einen erneuten Versuch in der Warteschlange."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать данные срабатывания. Они остаются в очереди для повторной попытки."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o alarme acionado. Ele permanece na fila para uma nova tentativa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म डिलीवरी पढ़ी नहीं जा सकी। दोबारा कोशिश के लिए वह कतार में बनी हुई है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਲਾਰਮ ਡਿਲੀਵਰੀ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਲਈ ਉਹ ਕਤਾਰ ਵਿੱਚ ਰਹੇਗੀ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্মের ডেলিভারি পড়া যায়নি। আবার চেষ্টা করার জন্য এটি সারিতে রয়েছে।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取闹钟触发数据。它仍在队列中，可供重试。"
          }
        }
      }
    },
    "Enter a whole number. Negative answers are allowed.": {
      "extractionState": "manual",
      "comment": "Native Milestone 5 challenge presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole number. Negative answers are allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
