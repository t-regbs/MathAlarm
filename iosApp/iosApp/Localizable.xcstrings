    "Add or edit an alarm, then tap %@." : {
      "extractionState" : "stale",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যালার্ম যোগ বা সম্পাদনা করুন, তারপর %@ে ট্যাপ করুন।"
