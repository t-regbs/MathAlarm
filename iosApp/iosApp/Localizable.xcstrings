    "Test Alarm is scheduled for Milestone 5. Your draft is retained.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Alarm is scheduled for Milestone 5. Your draft is retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar alarma está previsto para el hito 5. Se conserva tu borrador."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testalarm ist für Meilenstein 5 geplant. Dein Entwurf bleibt erhalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка будильника запланирована на этап 5. Черновик сохранён."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Testar alarme está previsto para a etapa 5. Seu rascunho é mantido."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म परीक्षण चरण 5 में आएगा। आपका ड्राफ़्ट सुरक्षित है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਲਾਰਮ ਦੀ ਜਾਂਚ ਪੜਾਅ 5 ਵਿੱਚ ਆਵੇਗੀ। ਤੁਹਾਡਾ ਡਰਾਫ਼ਟ ਸੰਭਾਲਿਆ ਹੈ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ম পরীক্ষা ধাপ ৫-এ আসবে। আপনার খসড়া রাখা হয়েছে।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "测试闹钟将在里程碑5实现。您的草稿会保留。"
          }
        }
      },
      "comment": "Native Milestone 4 presentation."
    },
    "The alarm draft is not ready. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm draft is not ready. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador no está listo. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Alarmentwurf ist nicht bereit. Versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновик будильника ещё не готов. Повторите попытку."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O rascunho não está pronto. Tente novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म ड्राफ़्ट तैयार नहीं है। फिर कोशिश करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਲਾਰਮ ਦਾ ਡਰਾਫ਼ਟ ਤਿਆਰ ਨਹੀਂ ਹੈ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্মের খসড়া প্রস্তুত নয়। আবার চেষ্টা করুন।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟草稿尚未准备好。请重试。"
          }
        }
      },
      "comment": "Native Milestone 4 presentation."
    },
