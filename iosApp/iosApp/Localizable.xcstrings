    "Changes apply to this draft. Save the alarm to keep them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply to this draft. Save the alarm to keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican a este borrador. Guarda la alarma para conservarlos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten für diesen Entwurf. Speichere den Alarm, um sie zu behalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения относятся к черновику. Сохраните будильник, чтобы оставить их."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações valem para este rascunho. Salve o alarme para mantê-las."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव इस ड्राफ़्ट में लागू हैं। उन्हें रखने के लिए अलार्म सहेजें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਬਦੀਲੀਆਂ ਇਸ ਡਰਾਫ਼ਟ ਵਿੱਚ ਹਨ। ਉਹਨਾਂ ਨੂੰ ਰੱਖਣ ਲਈ ਅਲਾਰਮ ਸੰਭਾਲੋ।"
          }
