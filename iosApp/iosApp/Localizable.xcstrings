    "A delivered alarm has priority over tone previews.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A delivered alarm has priority over tone previews."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una alarma activa tiene prioridad sobre la escucha de tonos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgelöster Alarm hat Vorrang vor der Tonvorschau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сработавший будильник имеет приоритет перед прослушиванием."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um alarme ativo tem prioridade sobre a prévia dos sons."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बज रहे अलार्म को ध्वनि पूर्वावलोकन पर प्राथमिकता मिलती है।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਜ ਰਹੇ ਅਲਾਰਮ ਨੂੰ ਧੁਨ ਦੀ ਪੂਰਵ-ਝਲਕ ਉੱਤੇ ਤਰਜੀਹ ਮਿਲਦੀ ਹੈ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাজতে থাকা অ্যালার্ম ধ্বনি প্রিভিউয়ের চেয়ে অগ্রাধিকার পায়।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已触发的闹钟优先于铃声试听。"
          }
        }
      },
      "comment": "Native Milestone 4 presentation."
    },
