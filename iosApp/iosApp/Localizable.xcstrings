    "Delete all alarms?" : {
      "comment" : "Ported from the existing Android Lyricist catalog.",
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কি সত্যিই এই অ্যালার্মটি মুছতে চান?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie die Alarme löschen möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to clear the alarms?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que quieres borrar esta alarmas?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई अलार्म साफ़ करना चाहते हैं?"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੀ ਤੁਸੀਂ ਇਹ ਅਲਾਰਮ ਸਾਫ਼ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja limpar os alarmes?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите сбросить сигналы тревоги?"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要清除警報嗎？"
          }
        }
      }
    },
    "Delivery could not be decoded. It remains queued for retry." : {
      "comment" : "Native Milestone 5 delivery presentation.",
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যালার্মের ডেলিভারি পড়া যায়নি। আবার চেষ্টা করার জন্য এটি সারিতে রয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ausgelöste Alarm konnte nicht gelesen werden. Er bleibt für einen erneuten Versuch in der Warteschlange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivery could not be decoded. It remains queued for retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la entrega. Permanece en la cola para reintentar."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलार्म डिलीवरी पढ़ी नहीं जा सकी। दोबारा कोशिश के लिए वह कतार में बनी हुई है।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅਲਾਰਮ ਡਿਲੀਵਰੀ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਲਈ ਉਹ ਕਤਾਰ ਵਿੱਚ ਰਹੇਗੀ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o alarme acionado. Ele permanece na fila para uma nova tentativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать данные срабатывания. Они остаются в очереди для повторной попытки."
          }
        },
