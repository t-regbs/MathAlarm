          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las alarmas para programar esta alarma y vuelve a guardarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Alarme, um diesen Alarm zu planen, und speichere ihn erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите будильники, чтобы запланировать этот будильник, затем сохраните его снова."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita alarmes para agendar este alarme e tente salvar novamente."
