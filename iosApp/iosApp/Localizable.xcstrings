    "Alarm recovery needs attention. Try again.": {
      "extractionState": "manual",
      "comment": "Native Milestone 5 recovery scheduling, cancellation or cleanup failure.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm recovery needs attention. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación de la alarma necesita atención. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erneute Alarmauslösung erfordert Aufmerksamkeit. Versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление будильника требует внимания. Попробуйте ещё раз."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação do alarme precisa de atenção. Tente novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म की रिकवरी पर ध्यान देने की ज़रूरत है। फिर कोशिश करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਲਾਰਮ ਦੀ ਰਿਕਵਰੀ ਵੱਲ ਧਿਆਨ ਦੇਣ ਦੀ ਲੋੜ ਹੈ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ম পুনরুদ্ধারে মনোযোগ দেওয়া প্রয়োজন। আবার চেষ্টা করুন।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟恢复需要处理。请重试。"
          }
        }
      }
    },
