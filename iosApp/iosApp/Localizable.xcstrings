    "Open %@ to turn snooze on or off, or change its limit and duration." : {
      "extractionState" : "stale",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্নুজ চালু বা বন্ধ করতে অথবা সীমা ও সময় পরিবর্তন করতে %@ খুলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne %@, um Schlummern ein- oder auszuschalten oder Limit und Dauer zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open %@ to turn snooze on or off, or change its limit and duration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre %@ para activar o desactivar la función, o cambiar su límite y duración."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्नूज़ चालू या बंद करने या उसकी सीमा और समय बदलने के लिए %@ खोलें।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਨੂਜ਼ ਚਾਲੂ ਜਾਂ ਬੰਦ ਕਰਨ ਜਾਂ ਇਸਦੀ ਸੀਮਾ ਅਤੇ ਸਮਾਂ ਬਦਲਣ ਲਈ %@ ਖੋਲ੍ਹੋ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra %@ para ativar ou desativar, ou alterar o limite e a duração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте «%@», чтобы включить или выключить повтор либо изменить лимит и длительность."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“%@”以开启或关闭此功能，或更改次数上限和间隔。"
          }
        }
      }
    },
