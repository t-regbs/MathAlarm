    "Unable to retain delivery acknowledgement. Try again.": {
      "extractionState": "manual",
      "comment": "Native Milestone 5 delivery presentation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to retain delivery acknowledgement. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la confirmación de entrega. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bestätigung des ausgelösten Alarms konnte nicht gespeichert werden. Versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить подтверждение срабатывания. Попробуйте ещё раз."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a confirmação do alarme acionado. Tente novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म डिलीवरी की पुष्टि सहेजी नहीं जा सकी। फिर कोशिश करें।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਲਾਰਮ ਡਿਲੀਵਰੀ ਦੀ ਪੁਸ਼ਟੀ ਸੰਭਾਲੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালার্ম ডেলিভারির স্বীকৃতি সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存闹钟触发确认。请重试。"
          }
        }
      }
    },
